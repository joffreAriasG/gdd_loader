# Copiar este archivo como ".env" (NO subir ".env" a git) y completar.

# --- Origen (carpeta sincronizada de SharePoint via OneDrive) ---
GDD_CARPETA_ORIGEN=C:\Users\TU_USUARIO\OneDrive - TU_ORGANIZACION\CARPETA_PLANTILLAS

# --- Destino SQL Server on-prem ---
GDD_SQL_SERVIDOR=TU_SERVIDOR_ONPREM
GDD_SQL_BASE_DATOS=DGODELIVERY
GDD_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Autenticacion: WINDOWS o SQL
GDD_SQL_AUTH_MODO=WINDOWS
GDD_SQL_USUARIO=
GDD_SQL_PASSWORD=

# --- Estrategia de carga a staging ---
# DOMINIO  = borra solo las filas de staging cuyo dominio (o clave de
#            SheetConfig.columna_clave) viene en el archivo cargado, y las
#            reinserta. No afecta otros dominios ya cargados en la misma
#            tabla. Modo normal de operacion con multiples dominios (default).
# TRUNCATE = vacia TODA la tabla antes de insertar. Borra tambien otros
#            dominios ya cargados ahi — usar solo para un reset manual
#            completo, no en operacion normal.
GDD_ESTRATEGIA_STAGING=DOMINIO

# --- Logging ---
GDD_LOG_DIR=logs
GDD_LOG_LEVEL=INFO
