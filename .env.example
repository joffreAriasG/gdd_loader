# Copiar este archivo como ".env" (NO subir ".env" a git) y completar.

# --- Origen (carpeta sincronizada de SharePoint via OneDrive) ---
GDD_CARPETA_ORIGEN=C:\Users\TU_USUARIO\OneDrive - TU_ORGANIZACION\CARPETA_PLANTILLAS

# --- Destino SQL Server on-prem ---
GDD_SQL_SERVIDOR=TU_SERVIDOR_ONPREM
GDD_SQL_BASE_DATOS=DGODELIVERY
GDD_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Autenticacion: WINDOWS o SQL
GDD_SQL_AUTH_MODO=WINDOWS
GDD_SQL_USUARIO=
GDD_SQL_PASSWORD=

# --- Estrategia de carga a staging ---
# DOMINIO  = borra solo las filas de staging cuyo dominio (o clave de
#            SheetConfig.columna_clave) viene en el archivo cargado, y las
#            reinserta. No afecta otros dominios ya cargados en la misma
#            tabla. Modo normal de operacion con multiples dominios (default).
# TRUNCATE = vacia TODA la tabla antes de insertar. Borra tambien otros
#            dominios ya cargados ahi — usar solo para un reset manual
#            completo, no en operacion normal.
GDD_ESTRATEGIA_STAGING=DOMINIO

# --- Logging ---
GDD_LOG_DIR=logs
GDD_LOG_LEVEL=INFO

# --- Fase 1: control de cargas (procesar_cli) ---
# Carpetas sincronizadas de SharePoint. Archivo y Rechazados deben ser una
# biblioteca con permisos SOLO para el equipo de gobierno de datos, y
# distintas de GDD_CARPETA_ORIGEN (Entrada).
GDD_CARPETA_ARCHIVO=C:\Users\TU_USUARIO\OneDrive - TU_ORGANIZACION\CARPETA_ARCHIVO
GDD_CARPETA_RECHAZADOS=C:\Users\TU_USUARIO\OneDrive - TU_ORGANIZACION\CARPETA_RECHAZADOS

# Plantilla registrada en gdd.plantilla
GDD_ID_PLANTILLA=GDD-DOMINIO

# NO = transicion: acepta archivos sin hoja _Control si su estructura coincide
#      con una version registrada (queda la advertencia en carga_control).
# SI = solo acepta plantillas con hoja _Control (activar desde la fecha de corte).
GDD_EXIGIR_CONTROL=NO

# Un archivo se procesa solo si no se modifico en los ultimos N segundos
# (evita leerlo mientras OneDrive lo sincroniza).
GDD_SEGUNDOS_ESTABILIDAD=60

# Retencion de archivos en Archivo/Rechazados (0 = no purgar).
GDD_DIAS_RETENCION=365
